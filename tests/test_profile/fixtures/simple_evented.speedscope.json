{
  "$schema": "https://www.speedscope.app/file-format-schema.json",
  "name": "simple_evented_profile",
  "shared": {
    "frames": [
      { "name": "main", "file": "src/main.py", "line": 10 },
      { "name": "process_data", "file": "src/process.py", "line": 25 },
      { "name": "calculate", "file": "src/math.py", "line": 50 }
    ]
  },
  "profiles": [
    {
      "type": "evented",
      "name": "Evented Test",
      "unit": "milliseconds",
      "startValue": 0,
      "endValue": 500,
      "events": [
        { "type": "O", "frame": 0, "at": 0 },
        { "type": "O", "frame": 1, "at": 50 },
        { "type": "O", "frame": 2, "at": 100 },
        { "type": "C", "frame": 2, "at": 300 },
        { "type": "C", "frame": 1, "at": 400 },
        { "type": "C", "frame": 0, "at": 500 }
      ]
    }
  ]
}
