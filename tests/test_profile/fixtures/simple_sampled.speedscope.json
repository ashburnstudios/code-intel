{
  "$schema": "https://www.speedscope.app/file-format-schema.json",
  "name": "simple_sampled_profile",
  "exporter": "test@1.0.0",
  "shared": {
    "frames": [
      { "name": "main", "file": "src/main.py", "line": 10 },
      { "name": "process_data", "file": "src/process.py", "line": 25 },
      { "name": "calculate", "file": "src/math.py", "line": 50 },
      { "name": "helper", "file": "src/utils.py", "line": 100 }
    ]
  },
  "profiles": [
    {
      "type": "sampled",
      "name": "Test Profile",
      "unit": "milliseconds",
      "startValue": 0,
      "endValue": 1000,
      "samples": [
        [0, 1, 2],
        [0, 1, 2],
        [0, 1, 3],
        [0, 1],
        [0]
      ],
      "weights": [200, 300, 150, 200, 150]
    }
  ]
}
