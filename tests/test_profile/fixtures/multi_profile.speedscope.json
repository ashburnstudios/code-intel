{
  "$schema": "https://www.speedscope.app/file-format-schema.json",
  "name": "multi_profile_test",
  "shared": {
    "frames": [
      { "name": "main" },
      { "name": "fast_function" },
      { "name": "slow_function" }
    ]
  },
  "profiles": [
    {
